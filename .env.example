# RPC Configuration
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Deployment Account
# IMPORTANT: Never commit your actual private key! Use a dedicated deployment wallet.
PRIVATE_KEY=your_private_key_here

# Block Explorer API Key
# Get your API key from https://basescan.org/myapikey
BASESCAN_API_KEY=your_basescan_api_key_here

# Gas Reporter (Optional)
REPORT_GAS=false
GAS_REPORT_FILE=

# Token Configuration
TOKEN_NAME=X402 Token
TOKEN_SYMBOL=X402
INITIAL_SUPPLY=1000000

# Registry Configuration
REGISTRATION_FEE=10

# Session Manager Configuration
# Treasury wallet address for protocol fees
TREASURY=your_treasury_wallet_address_here
# Protocol fee in basis points (500 = 5%)
PROTOCOL_FEE_BPS=500
