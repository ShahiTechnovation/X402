# Example environment file for the X402 node agent.
#
# Copy this file to /etc/x402/node-agent.env on the target host (or encode it as
# NODE_AGENT_ENV_B64 when running infra/bootstrap-node.sh). Replace placeholder
# values with your deployment-specific configuration and never commit secrets.

NODE_ENV=production
LOG_LEVEL=info
NODE_AGENT_NAME=wg-node-1
NODE_REGION=iad

# RPC + contract wiring (Base Sepolia)
X402_RPC_URL=https://sepolia.base.org
X402_CHAIN_ID=84532
X402_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
X402_NODE_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
X402_SESSION_MANAGER_ADDRESS=0x0000000000000000000000000000000000000000

# Node identity
NODE_ID=0
NODE_ENDPOINT=wireguard://vpn-node-1.example.com:51820
NODE_RATE_PER_HOUR=10000000000000000000 # 10 X402/hour expressed in wei

# Signing identity for on-chain actions (store via a secrets manager!)
NODE_OPERATOR_ADDRESS=0x0000000000000000000000000000000000000000
NODE_OPERATOR_PRIVATE_KEY=replace-with-hot-wallet-key

# WireGuard metadata surfaced to control-plane telemetry
WIREGUARD_PUBLIC_KEY=replace-with-wg-public-key
WIREGUARD_ALLOWED_IPS=10.42.0.0/24

# Optional observability hooks
HEALTHCHECK_HTTP_ENDPOINT=https://hc-ping.com/your-uuid
SENTRY_DSN=
PAPERTRAIL_ENDPOINT=

# Protocol fee routing (matches SessionManager feeRecipient)
PROTOCOL_FEE_RECIPIENT=0x0000000000000000000000000000000000000000
